{
  "name": "ai-market-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint",
    "check:meta": "node --env-file-if-exists=.env.local scripts/check-meta.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:local-release": "node scripts/check-local-release.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "16.4.4",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "typescript": "^5"
  },
  "type": "module"
}
