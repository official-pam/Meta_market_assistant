# Copy to .env.local and fill in secrets locally. Never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_TEXT_PROTOCOL=chat
META_VOICE_MODEL=muse-voice-transcribe-1.0
# Keep disabled until the deferred API access/credits smoke check is complete.
ENABLE_META_CALLS=false

# Enable only for a database containing simulated demo records.
DEMO_MODE=false
LOCAL_DEMO_DATABASE=false
ALLOW_DEMO_SEED=false
# Keep a fixed date for a reproducible historical snapshot, or omit to use today's date.
# DEMO_AS_OF=2026-11-03
# Use separate random values; do not reuse your Meta key.
SESSION_SECRET=
DEMO_ACCESS_CODE=
APP_ORIGIN=http://localhost:3000
